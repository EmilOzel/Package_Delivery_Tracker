@baseUrl = http://localhost:7070/api

### Registrer bruger
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Emil Ozel",
  "email": "emil@example.com",
  "password": "Sikkert-password-2026"
}

### Login og gem JWT
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "emil@example.com",
  "password": "Sikkert-password-2026"
}

> {% client.global.set("token", response.body.token); %}

### Login som demo-medarbejder efter kørsel af Populate
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "employee@example.com",
  "password": "Employee-password-2026"
}

> {% client.global.set("employeeToken", response.body.token); %}

### Opret en pakke. Ejeren findes fra JWT-tokenet
POST {{baseUrl}}/parcels
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "senderName": "Emil Ozel",
  "recipientName": "Bo Jensen",
  "destinationAddress": "Amperestien 10, 2605 Brøndby"
}

> {%
    client.global.set("parcelId", response.body.id);
    client.global.set("trackingNumber", response.body.trackingNumber);
%}

### Hent brugerens egne pakker
GET {{baseUrl}}/parcels
Authorization: Bearer {{token}}
Accept: application/json

### Hent pakke efter trackingnummer
GET {{baseUrl}}/parcels/tracking/{{trackingNumber}}
Authorization: Bearer {{token}}
Accept: application/json

### Hent pakkens historik
GET {{baseUrl}}/parcels/{{parcelId}}/events
Authorization: Bearer {{token}}
Accept: application/json

### Statusændring kræver et EMPLOYEE- eller ADMIN-token
PUT {{baseUrl}}/parcels/{{parcelId}}/status
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "status": "PICKED_UP",
  "location": "Brøndby",
  "message": "Pakken er blevet afhentet"
}

### WebSocket
# ws://localhost:7070/api/parcels/{{trackingNumber}}/live
